# ---------------------------------------------------------------------------
# Google Sheet — the single source of truth for every lease record.
# Copy to .env.local (git-ignored) and fill in. See SETUP.md for the walkthrough.
# ---------------------------------------------------------------------------

# Required: the long ID in the sheet URL
# https://docs.google.com/spreadsheets/d/<THIS PART>/edit
VITE_SHEET_ID=

# Tab name inside the spreadsheet (default: Portfolio)
VITE_SHEET_NAME=Portfolio

# Preferred transport: Sheets API v4. Browser-key restricted, read-only scope.
# Leave blank to use the published-CSV fallback instead.
VITE_SHEETS_API_KEY=

# Only needed by the CSV fallback when the tab is not the first one (the #gid= in the URL)
VITE_SHEET_GID=

# Behavior
VITE_EXPIRING_MONTHS=12
VITE_RUNWAY_MONTHS=66
VITE_SOURCE_LABEL=Rimkus Real Estate Portfolio Summary · Prepared by Cresa

# Dev only: render the bundled sample fixture instead of calling the sheet.
# Never set this in a deployed build.
VITE_USE_FIXTURE=false
